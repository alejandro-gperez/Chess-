# ==========================================
# Rust & Cargo
# ==========================================
/target/
**/*.rs.bk
*.rs.in
Cargo.lock

# Note: Un-comment 'Cargo.lock' below if you are building a binary library instead of an executable application.
# For executable games/applications, committing Cargo.lock is usually recommended, 
# but if you prefer reproducible clean builds, keep Cargo.lock out or in based on your workflow.
!Cargo.lock

# Cargo build artifacts / temporary files
*.rlib
*.rmeta
*.so
*.dylib
*.dll
*.exe

# ==========================================
# macOS System Files
# ==========================================
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# ==========================================
# IDEs & Code Editors
# ==========================================
# Visual Studio Code
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
*.code-workspace

# JetBrains / CLion / IntelliJ
.idea/
*.iml

# Vim / Sublime / Emacs
*.swp
*~
*.bak
.sublime-project
.sublime-workspace

# ==========================================
# Raylib / C Dependencies & Local Assets
# ==========================================
# Build outputs from native libraries or C bindings if generated locally
/raylib/
*.o
*.a

# Environment / Local settings
.env
.env.local

# Logs and Crash Dumps
*.log
crash.dmp
